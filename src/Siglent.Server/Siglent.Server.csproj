<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Siglent.Scope\Siglent.Scope.csproj" />
    <ProjectReference Include="..\Siglent.Simulator\Siglent.Simulator.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <WebDir>$(MSBuildThisFileDirectory)..\..\web\</WebDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Siglent.Scope.Tests" />
  </ItemGroup>

  <!-- The UI (built by Vite into wwwroot) is embedded in the assembly instead of being served from disk. -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
    <WebSource Include="$(WebDir)src\**;$(WebDir)index.html;$(WebDir)package.json;$(WebDir)vite.config.ts" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.13" />
  </ItemGroup>

  <!-- Rebuilds the UI when its sources change. Pass -p:SkipWebBuild=true to skip (e.g. without Node.js). -->
  <Target Name="BuildWeb" BeforeTargets="PrepareForBuild" Condition="'$(SkipWebBuild)' != 'true'" Inputs="@(WebSource)" Outputs="wwwroot\index.html">
    <Exec Command="npm install" WorkingDirectory="$(WebDir)" Condition="!Exists('$(WebDir)node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(WebDir)" />
    <!-- Re-collect the build output; a glob Remove would miss items whose files Vite just deleted. -->
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('wwwroot'))" />
      <EmbeddedResource Include="wwwroot\**" />
    </ItemGroup>
  </Target>

</Project>
